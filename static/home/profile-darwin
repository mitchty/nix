# Ok so something seems to have changed in how the final emacs wrapped binary
# gets built in 25.11 nixpkgs...
#
# What used to work:
# - open -a /path/to/wrapped/bin
#
# What seems to need to happen now is I need to use the -wrapped version on
# macos vs the mainProgram binary, that is:
# - open -a /path/to/wrapped/.bin-wrapped
#
# Sooooo.... we need to go from "what does which think from $PATH emacs is
# located at" all the way down to the final binary /nix/store symlink chain
# shenanigans and then swap that binary to the .emacs-wrapped binary instead
# now.
#
# Given i'm running nix I can use gnu realpath which recursively does the
# symlink resolution until file nonsense.
#
# Also, why is all of computing lately so damn brittle, I love updates and all
# but getting sick of treadmill debugging all the time. Pick a lane and stick
# with it until you can't. Consistency isn't a 4 letter word.
#
# Should probably figure out a way to make a check for this in nix flake
# check... so that I can prove my symlink wrapped emacs shenanigans is worth a
# spit to catch this stuff more quickly on updates.
oe() {
  bin=$(realpath $(which emacs))

  if [ -x "${bin}" ]; then
    dir=$(dirname "${bin}")
    f="${dir}/.emacs-wrapped"
    if [ -x "${f}" ]; then
      printf "open -a %s\n" "${f}" >&2
      open -a "${f}"
    else
      printf "couldn't find a .emacs-wrapped binary alongside .emacs\n" >&2
      return 2
    fi
  else
    printf "couldn't determine the final binary path for emacs\n" >&2
    return 1
  fi
}

# Kinda like which but for macos app bundles
#
# Was wondering where the hell open was opening stuff in nix, and my lord did I not expect every app bundle in /nix/store to show up...
#
# I don't know how to fix it though it seems like open -a picks the top entry so hell if I know the right way to fix this properly.
whichapp() {
  name="${1?need the app name}"
  lspath="/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister"
  ${lspath} -dump | grep "path[:].*/Applications/.*${name}.app " | sed -e 's/[.]app.*/.app/g' -e 's/path[:][[:blank:]]*//g' | uniq
}

# mnemonic: Nix (macos) App (bundle) Open
# Aka no in portuguese, I couldn't remember ona to save my life.
#
# This nukes all the /nix/store entries recorded by launchservices and hopefully
# ends up just with the trampoline in home manager or /Applications
nao() {
  name="${1?need the app name to open}"
  #shellcheck disable=SC2086
  open -a "$(whichapp ${name} | grep -v '/nix/store')"
}
