kdiff() {
  lhs="${1?need a number for the diff to start}"
  shift
  rhs="${1?need a number for the diff to end}"
  lhsid=$(kopia snapshot list | tac | awk 'NR == '"${rhs}"' && /files/ {print $4}')
  rhsid=$(kopia snapshot list | tac | awk 'NR == '"${lhs}"' && /files/ {print $4}')
