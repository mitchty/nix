#-*-mode: Shell-script; coding: utf-8;-*-
# SPDX-License-Identifier: BlueOak-1.0.0
# Description: Dum dum wrapper around find git-agecrypt to update the
# git-agecrypt.toml file.
_base=$(basename "$0")
_dir=$(cd -P -- "$(dirname -- "$(command -v -- "$0")")" && pwd -P || exit 126)
export _base _dir
set "${SETOPTS:--eu}"

cd "${_dir}/.." || exit 126

git-agecrypt config add -r "$(cat ~/.ssh/id_ed25519.pub)" -p $(find crypt -type f | sort)
treefmt git-agecrypt.toml
