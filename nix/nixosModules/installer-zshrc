#-*-mode: Shell-script; coding: utf-8;-*-
# Installer only zshrc config
set -o emacs

# Load common iso shell lib functions
# Run something as root depending on user
asroot() {
  if [ "$(id -u)" -ne 0 ]; then
    sudo "$@"
  else
    "$@"
  fi
}

# To find all the /dev/disk/... symlinks to a target device
# input could be like:
# sda|/dev/sda, so just see if its a block device first then prepend
# /dev/ to it and try that if it fails it fails.
disklinks() {
  target="${1?need a target bra}"

  if [ ! -b "${target}" ]; then
    target="/dev/${target}"
  fi
  asroot find -L /dev -xdev -samefile "${target}"
}

alias syso="echo o | asroot tee /proc/sysrq-trigger"
alias sysb="echo b | asroot tee /proc/sysrq-trigger"

alias off="asroot systemctl poweroff"
alias tofw="asroot systemctl reboot --firmware-setup"

alias autostatus="asroot systemctl status autoinstall"
alias autorestart="asroot systemctl restart autoinstall"
alias f="journalctl --no-pager -fu autoinstall"
alias fl="journalctl --no-pager -u autoinstall |  less"
